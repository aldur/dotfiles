+const THINKING_LEVELS = ["off", "minimal", "low", "medium", "high", "xhigh", "max"] as const;
+type ThinkingLevel = typeof THINKING_LEVELS[number];
+type AdvertisedThinking = {
+	levels: NonNullable<LlamaModel["thinkingLevelMap"]>;
+	defaultLevel?: ThinkingLevel;
+};
+
+// An advertised vocabulary describes top-level reasoning_effort. Use exact
+// supported words; do not guess a model family or round an unsupported effort.
+// A binary on/off contract gets a single Pi "medium" switch.
+function advertisedThinking(efforts: unknown, defaultEffort: unknown): AdvertisedThinking | undefined {
+	if (!Array.isArray(efforts) || !efforts.every((word) => typeof word === "string")) return;
+	const levels: AdvertisedThinking["levels"] = {};
+	for (const level of THINKING_LEVELS) {
+		levels[level] = efforts.includes(level) ? level : null;
+	}
+	if (efforts.includes("none") && !efforts.includes("off")) levels.off = "none";
+	if (!THINKING_LEVELS.slice(1).some((level) => typeof levels[level] === "string") && efforts.includes("on")) {
+		levels.medium = "on";
+	}
+	// Empty is an explicit no-reasoning declaration. An unknown vocabulary is
+	// inconclusive, so retain the existing template fallback for future servers.
+	if (efforts.length > 0 && !Object.values(levels).some((word) => typeof word === "string")) return;
+	const defaultLevel = typeof defaultEffort === "string"
+		? THINKING_LEVELS.find((level) => levels[level] === defaultEffort)
+		: undefined;
+	return { levels, defaultLevel };
+}
+
+function applyAdvertisedThinking(model: MutableModelMetadata, thinking: AdvertisedThinking): void {
+	model.reasoning = THINKING_LEVELS.slice(1).some((level) => typeof thinking.levels[level] === "string");
+	model.thinkingLevelMap = thinking.levels;
+	model.compat = {
+		...model.compat,
+		thinkingFormat: "openai",
+		supportsReasoningEffort: true,
+		chatTemplateKwargs: undefined,
+	};
+}
+
+function positiveContext(...values: unknown[]): number {
+	return values.find((value): value is number =>
+		typeof value === "number" && Number.isSafeInteger(value) && value > 0,
+	) ?? DEFAULT_CONTEXT_WINDOW;
+}
