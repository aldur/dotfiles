<?xml version="1.0" encoding="utf-8"?>
<!-- The settings are of no use on a different device: the TLS key cannot leave the Keystore. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
