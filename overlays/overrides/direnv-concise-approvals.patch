+
+// Bound both the number of paths and their combined display length. Quoting
+// prevents filenames containing control characters from disrupting the prompt.
+// This is display-only: DIRENV_REQUIRED always retains the complete list.
+func requiredFilesSummary(paths []string) string {
+	var preview []string
+	length := 0
+	for _, path := range paths {
+		quoted := fmt.Sprintf("%q", path)
+		if len(preview) == 3 || length+len(quoted) > 160 {
+			break
+		}
+		preview = append(preview, quoted)
+		length += len(quoted) + 2
+	}
+	if len(paths) == 1 {
+		if len(preview) == 1 {
+			return preview[0]
+		}
+		return "1 file"
+	}
+	summary := fmt.Sprintf("%d files", len(paths))
+	if len(preview) > 0 {
+		if remaining := len(paths) - len(preview); remaining > 0 {
+			preview = append(preview, fmt.Sprintf("and %d more", remaining))
+		}
+		summary += " (" + strings.Join(preview, ", ") + ")"
+	}
+	return summary
+}
