diff --git a/pkg/services/forwarder/host.go b/pkg/services/forwarder/host.go
new file mode 100644
index 0000000..7fdbfcf
--- /dev/null
+++ b/pkg/services/forwarder/host.go
@@ -0,0 +1,80 @@
+package forwarder
+
+import (
+	"net"
+	"sync"
+	"time"
+
+	log "github.com/sirupsen/logrus"
+	"gvisor.dev/gvisor/pkg/tcpip"
+)
+
+// hostGuardRefresh bounds how stale the interface list may be.
+const hostGuardRefresh = 10 * time.Second
+
+// HostGuard tells whether an address belongs to the host: loopback,
+// unspecified, or assigned to one of its interfaces.
+type HostGuard struct {
+	mu        sync.Mutex
+	addresses map[string]struct{}
+	refreshed time.Time
+	err       error
+}
+
+func NewHostGuard() *HostGuard {
+	return &HostGuard{}
+}
+
+// IsHost reports whether addr is an address of the host. While the
+// interface list cannot be read, every address counts as the host's:
+// the guard fails closed.
+func (g *HostGuard) IsHost(addr tcpip.Address) bool {
+	ip := net.IP(addr.AsSlice())
+	if ip.IsLoopback() || ip.IsUnspecified() {
+		return true
+	}
+	g.mu.Lock()
+	defer g.mu.Unlock()
+	if time.Since(g.refreshed) > hostGuardRefresh {
+		g.refresh()
+	}
+	if g.err != nil {
+		return true
+	}
+	_, ok := g.addresses[ip.String()]
+	return ok
+}
+
+func (g *HostGuard) refresh() {
+	g.refreshed = time.Now()
+	interfaceAddresses, err := net.InterfaceAddrs()
+	if err != nil {
+		log.Errorf("cannot list host addresses, refusing every destination: %v", err)
+		g.err = err
+		return
+	}
+	g.err = nil
+	g.addresses = make(map[string]struct{}, len(interfaceAddresses))
+	for _, address := range interfaceAddresses {
+		var ip net.IP
+		switch v := address.(type) {
+		case *net.IPNet:
+			ip = v.IP
+		case *net.IPAddr:
+			ip = v.IP
+		}
+		if ip != nil {
+			g.addresses[ip.String()] = struct{}{}
+		}
+	}
+}
+
+// isLoopbackListen reports whether a host:port bind address is loopback.
+func isLoopbackListen(local string) bool {
+	host, _, err := net.SplitHostPort(local)
+	if err != nil {
+		return false
+	}
+	ip := net.ParseIP(host)
+	return ip != nil && ip.IsLoopback()
+}
